    },
    {
      "id": "plans.archive.manifests",
      "file": "plans/archive/*/_MANIFEST.json",
      "block": "$frozen",
      "scale_ref": 8,
      "order_type": "frozen",
      "derive": {
        "fn": "derive.frozen_manifests",
        "args": { "exempt": "编码/排序校正豁免，登记在案" }
      },
      "consistency": ["历史形态，编码/排序校正豁免，登记在案"],
      "negative_ids": []
